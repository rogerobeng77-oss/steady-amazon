    <path
        android:pathData="M160,90 m-46,0 a46,46 0,1 1,92 0 a46,46 0,1 1,-92 0"
        android:strokeColor="#E0A458"
        android:strokeWidth="6"
        android:fillColor="#00000000" />
    <path
        android:pathData="M160,90 m-28,0 a28,28 0,1 1,56 0 a28,28 0,1 1,-56 0"
        android:strokeColor="#6B9071"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M160,90 m-10,0 a10,10 0,1 1,20 0 a10,10 0,1 1,-20 0"
        android:fillColor="#F3ECDD" />
</vector>
